# Copy to the target project's .github/workflows/doforme-telegram.yml.
# Copy telegram_bugs.py to .github/scripts/doforme_telegram.py first.
name: doforme bug Telegram
on:
  issues:
    types: [opened, labeled, closed, reopened]
  issue_comment:
    types: [created]
  workflow_dispatch:
    inputs:
      issue_number:
        description: Recheck one issue; existing attempted receipts still prevent resend
        required: true
        type: string
permissions:
  contents: read
  issues: read
  pull-requests: read
  checks: read
  actions: read
concurrency:
  group: doforme-telegram-${{ github.repository }}-${{ github.event.issue.number || inputs.issue_number }}
  cancel-in-progress: false
jobs:
  notify:
    if: vars.DOFORME_NOTIFY_TELEGRAM == 'true' && !github.event.issue.pull_request
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.event.repository.default_branch }}
          persist-credentials: false
      - name: Prepare notification from current GitHub metadata and owner evidence
        id: plan
        env:
          GH_TOKEN: ${{ github.token }}
          DOFORME_NOTIFY_TELEGRAM: ${{ vars.DOFORME_NOTIFY_TELEGRAM }}
          DOFORME_BUG_LABEL: ${{ vars.DOFORME_BUG_LABEL || 'bug' }}
          DOFORME_RESOLUTION_APPROVERS: ${{ vars.DOFORME_RESOLUTION_APPROVERS }}
          DOFORME_REQUIRED_CHECKS: ${{ vars.DOFORME_REQUIRED_CHECKS }}
        run: python3 -I -B .github/scripts/doforme_telegram.py prepare --event "$GITHUB_EVENT_PATH" --folder "$RUNNER_TEMP/doforme-telegram"
      - name: Persist attempt BEFORE Telegram delivery
        if: steps.plan.outputs.notify == 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: ${{ steps.plan.outputs.receipt_name }}
          path: ${{ runner.temp }}/doforme-telegram/attempt.json
          if-no-files-found: error
      - name: Revalidate current state and send once
        if: steps.plan.outputs.notify == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
          DOFORME_NOTIFY_TELEGRAM: ${{ vars.DOFORME_NOTIFY_TELEGRAM }}
          DOFORME_BUG_LABEL: ${{ vars.DOFORME_BUG_LABEL || 'bug' }}
          DOFORME_RESOLUTION_APPROVERS: ${{ vars.DOFORME_RESOLUTION_APPROVERS }}
          DOFORME_REQUIRED_CHECKS: ${{ vars.DOFORME_REQUIRED_CHECKS }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python3 -I -B .github/scripts/doforme_telegram.py send --event "$GITHUB_EVENT_PATH" --folder "$RUNNER_TEMP/doforme-telegram"
      - name: Preserve delivery diagnosis without credentials or source body
        if: always() && steps.plan.outputs.notify == 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: doforme-delivery-${{ github.run_id }}-${{ github.run_attempt }}
          path: |
            ${{ runner.temp }}/doforme-telegram/delivery.json
            ${{ runner.temp }}/doforme-telegram/delivered.json
          if-no-files-found: ignore
